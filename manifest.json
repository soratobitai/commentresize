{
    "manifest_version": 3,
    "name": "ニコ生コメントサイズ調整",
    "description": "ニコ生のコメント欄の文字サイズを調整できます。",
    "version": "1.2.21",
    "author": "MynicoTools",
    "minimum_chrome_version": "111",
    "icons": {
        "16": "icon.png",
        "48": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://live.nicovideo.jp/watch/*"
            ],
            "js": [
                "inject.js"
            ],
            "run_at": "document_start",
            "world": "MAIN"
        },
        {
            "matches": [
                "https://live.nicovideo.jp/watch/*"
            ],
            "js": [
                "main.js"
            ],
            "run_at": "document_start"
        }
    ],
    "permissions": [
        "storage"
    ]
}